<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep encrypted SMS data with its device-bound Keystore key. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="SmsHelper_Data.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="SmsHelper_Data.xml" />
    </device-transfer>
</data-extraction-rules>
